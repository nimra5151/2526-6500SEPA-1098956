# TutorBridge — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret — must be at least 64 characters, random
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_char_random_string

# App base URL (used in email links)
APP_URL=http://localhost:5000



NODE_ENV=development

# ── Email — Nodemailer (optional) ─────────────────────────────────────────────
# If not set, email features are silently skipped
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# ── OpenAI (optional) ─────────────────────────────────────────────────────────
# If not set, AI features are disabled
OPENAI_API_KEY=your_openai_api_key

# ── Zoom Server-to-Server OAuth (optional) ────────────────────────────────────
# If not set, live class Zoom features are disabled
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# If not set, Google sign-in button is hidden
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Pinecone — RAG Vector Database (optional) ────────────────────────────────
# Required for RAG AI Study Buddy feature
# 1. Go to pinecone.io → your project → API Keys → copy key
PINECONE_API_KEY=your_pinecone_api_key
# 2. The exact index name you created (e.g. tutorbridge)
PINECONE_INDEX=tutorbridge
