# TutorBridge — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Required ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/tutorbridge
# Hosted:  postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/tutorbridge

# JWT signing secret — must be at least 32 characters, cryptographically random
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Base URL of your app (used in password-reset and verification email links)
# Local:       http://localhost:5000
# Production:  https://yourdomain.com
APP_URL=http://localhost:5000

# Server port (default: 5000)
PORT=5000

# Set to "production" when deploying
NODE_ENV=development

# ── Email — Nodemailer (optional) ──────────────────────────────────────────────
# Without these, email features (verification, password reset, grading) are silently skipped
# For Gmail: create a Google App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# ── OpenAI (optional) ──────────────────────────────────────────────────────────
# Without this, AI Study Buddy, AI grading, and AI lesson tools are disabled
OPENAI_API_KEY=sk-...

# ── Zoom Server-to-Server OAuth (optional) ─────────────────────────────────────
# Without these, live-class Zoom features are disabled
# Create a Server-to-Server OAuth app at https://marketplace.zoom.us/
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ── Google OAuth (optional) ────────────────────────────────────────────────────
# Without these, the "Sign in with Google" button is hidden
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Pinecone — RAG Vector Database (optional) ──────────────────────────────────
# Required only for the AI Study Buddy RAG (Retrieval-Augmented Generation) feature
# 1. Sign up at https://pinecone.io and create an index named "tutorbridge" (1536 dimensions)
# 2. Copy your API key from the Pinecone console
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=tutorbridge
